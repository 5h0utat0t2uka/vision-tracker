{
  "name": "vision-track",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare:mediapipe-assets": "node scripts/copy-mediapipe-wasm.mjs",
    "predev": "pnpm prepare:mediapipe-assets",
    "dev": "vite",
    "prebuild": "pnpm prepare:mediapipe-assets",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.ts",
    "test:browser": "tsc -p tsconfig.browser-tests.json && playwright test",
    "typecheck": "tsc -b",
    "check:pre-commit": "nix develop -c prek run --all-files",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxc-transform-react": "^0.149.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  }
}
