{
  "name": "vision-track",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare:mediapipe-assets": "node scripts/copy-mediapipe-wasm.mjs",
    "predev": "pnpm prepare:mediapipe-assets",
    "dev": "vite",
    "prebuild": "pnpm prepare:mediapipe-assets",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -b",
    "check:pre-commit": "nix develop -c prek run --all-files",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  }
}
